  "turns": [
    {
      "seq": 1,
      "speaker": "employee",
      "text": "Банк, меня зовут Сергей, здравствуйте.",
      "t0_ms": 0,
      "t1_ms": 3180
    },
    {
      "seq": 2,
      "speaker": "client",
      "text": "Нужна дебетовая карта, чтобы без комиссий платить по QR.",
      "t0_ms": 3580,
      "t1_ms": 7840
    },
    {
      "seq": 3,
      "speaker": "employee",
      "text": "Назовите, пожалуйста, кодовое слово и дату рождения.",
      "t0_ms": 8240,
      "t1_ms": 12260
    },
    {
      "seq": 4,
      "speaker": "client",
      "text": "Кодовое слово «Ромашка», двенадцатое марта.",
      "t0_ms": 12660,
      "t1_ms": 16140
    },
    {
      "seq": 5,
      "speaker": "employee",
      "text": "Чем могу помочь? Что вас интересует в первую очередь?",
      "t0_ms": 16540,
      "t1_ms": 20620
    },
    {
      "seq": 6,
      "speaker": "client",
      "text": "Важнее доходность.",
      "t0_ms": 21020,
      "t1_ms": 23000
    },
    {
      "seq": 7,
      "speaker": "employee",
      "text": "Обслуживание карты бесплатное, оплата по QR и картой без комиссии, кешбэк один процент.",
      "t0_ms": 23400,
      "t1_ms": 29520
    },
    {
      "seq": 8,
      "speaker": "client",
      "text": "Это точно без скрытых условий?",
      "t0_ms": 29920,
      "t1_ms": 32620
    },
    {
      "seq": 9,
      "speaker": "employee",
      "text": "Досрочное закрытие — по ставке до востребования, комиссий нет. Можете взять договор домой и вернуться завтра.",
      "t0_ms": 33020,
      "t1_ms": 40460
    },
    {
      "seq": 10,
      "speaker": "client",
      "text": "Да, подходит.",
      "t0_ms": 40860,
      "t1_ms": 42540
    },
    {
      "seq": 11,
      "speaker": "employee",
      "text": "Итак, резюмирую: дебетовая карта с бесплатным обслуживанием и кешбэком. Если всё верно, оформляем.",
      "t0_ms": 42940,
      "t1_ms": 49720
    },
    {
      "seq": 12,
      "speaker": "employee",
      "text": "Спасибо за обращение, до свидания.",
      "t0_ms": 50120,
      "t1_ms": 53060
    }
  ],
