{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitverse.ru/florren/vibebashers/contracts/events/sim/team_plan.schema.json",
  "title": "team.plan — сохранённое решение планировщика до первого действия",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "version",
    "incident_id",
    "team",
    "plan"
  ],
  "properties": {
    "event_type": {
      "const": "team.plan"
    },
    "version": {
      "const": 1
    },
    "incident_id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "team": {
      "$ref": "../common.schema.json#/$defs/team"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_code",
        "sla_breach",
        "do_clarify",
        "outcome",
        "paused_after_clarify",
        "resumed",
        "steps"
      ],
      "properties": {
        "team_code": {
          "$ref": "../common.schema.json#/$defs/team"
        },
        "sla_breach": {
          "type": "boolean"
        },
        "do_clarify": {
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "on_time",
                "late",
                "no_work",
                "failed",
                "recovered"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "paused_after_clarify": {
          "type": "boolean"
        },
        "resumed": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "at",
              "report_day",
              "skipped",
              "regression",
              "due"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "take",
                  "clarify",
                  "rca",
                  "fix_decision",
                  "progress_report",
                  "release",
                  "verify",
                  "close",
                  "escalate_ack"
                ]
              },
              "at": {
                "$ref": "../common.schema.json#/$defs/sim_time"
              },
              "report_day": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "skipped": {
                "type": "boolean"
              },
              "regression": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "error_code",
                      "system",
                      "product",
                      "delay_min",
                      "origin_system"
                    ],
                    "properties": {
                      "error_code": {
                        "$ref": "../common.schema.json#/$defs/error_code"
                      },
                      "system": {
                        "$ref": "../common.schema.json#/$defs/system"
                      },
                      "product": {
                        "anyOf": [
                          {
                            "$ref": "../common.schema.json#/$defs/product"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "delay_min": {
                        "type": "integer",
                        "minimum": 60,
                        "maximum": 240
                      },
                      "origin_system": {
                        "$ref": "../common.schema.json#/$defs/system"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "due": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/sim_time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "event_type": "team.plan",
      "version": 1,
      "incident_id": 1,
      "team": "team_deposits",
      "plan": {
        "team_code": "team_deposits",
        "sla_breach": false,
        "do_clarify": false,
        "outcome": null,
        "paused_after_clarify": false,
        "resumed": false,
        "steps": [
          {
            "action": "take",
            "at": "2026-11-09T11:00:00+03:00",
            "report_day": null,
            "skipped": false,
            "regression": null,
            "due": null
          }
        ]
      }
    }
  ]
}
