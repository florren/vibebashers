{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitverse.ru/florren/vibebashers/contracts/events/sim/review.schema.json",
  "title": "review.posted | review.replied | review.escalated_to_dm — пост на эмуляторе внешней площадки (ТЗ 21.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "post_id",
    "platform",
    "author_nick",
    "posted_at"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "review.posted",
        "review.replied",
        "review.escalated_to_dm"
      ]
    },
    "post_id": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "platform": {
      "$ref": "../common.schema.json#/$defs/platform"
    },
    "author_nick": {
      "type": "string"
    },
    "author_client_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "match_confidence": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/confidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 4000
    },
    "mentions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_last4": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone_masked": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "signal_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reply_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reply_latency_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "demo",
        "api",
        "background",
        "scenario",
        "telegram_bot"
      ]
    },
    "posted_at": {
      "type": "string",
      "format": "date-time"
    },
    "posted_sim": {
      "$ref": "../common.schema.json#/$defs/sim_time"
    }
  },
  "examples": [
    {
      "event_type": "review.posted",
      "post_id": 17,
      "platform": "review_portal",
      "author_nick": "@ivan_v",
      "author_client_id": null,
      "match_confidence": null,
      "text": "Оплатил по QR в кафе, а Банк списал 450 руб комиссии! Карта **** 4512. Ещё раз — и закрою счёт",
      "mentions": {
        "card_last4": "4512",
        "phone_masked": null,
        "city": null
      },
      "signal_id": null,
      "reply_id": null,
      "reply_latency_ms": null,
      "origin": "demo",
      "posted_at": "2026-10-21T10:00:00Z",
      "posted_sim": "2026-10-07T11:30:00Z"
    }
  ]
}
