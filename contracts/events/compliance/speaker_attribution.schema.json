{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitverse.ru/florren/vibebashers/contracts/events/compliance/speaker_attribution.schema.json",
  "title": "Structured output авто-атрибуции роли спикера (режим auto, ТЗ 22.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "speaker",
    "confidence",
    "reason_ru"
  ],
  "properties": {
    "speaker": {
      "$ref": "../common.schema.json#/$defs/speaker"
    },
    "confidence": {
      "$ref": "../common.schema.json#/$defs/confidence"
    },
    "reason_ru": {
      "type": "string",
      "maxLength": 200
    }
  },
  "examples": [
    {
      "speaker": "employee",
      "confidence": 0.86,
      "reason_ru": "Предлагает продукт и описывает условия — типичная речь менеджера"
    }
  ]
}
