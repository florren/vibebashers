{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitverse.ru/florren/vibebashers/contracts/events/rules/rule_condition.schema.json",
  "title": "business_rules.condition — декларативное условие (подмножество JSON-логики) над операцией, проводками и тарифом (ТЗ 9.6)",
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "and"
          ],
          "properties": {
            "and": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "or"
          ],
          "properties": {
            "or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "field"
          ],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "exists",
                "within_seconds_of"
              ]
            },
            "field": {
              "type": "string",
              "pattern": "^(operation|ledger|tariff|client|context)\\.[a-z0-9_\\.]+$"
            },
            "value": {},
            "other_field": {
              "type": "string"
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "when"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "operation",
        "operation_pair",
        "client_window"
      ],
      "description": "Над чем вычисляется: одна операция; пара операций; окно операций клиента"
    },
    "window_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "when": {
      "$ref": "#/$defs/expr"
    },
    "description_ru": {
      "type": "string"
    }
  },
  "examples": [
    {
      "scope": "operation",
      "description_ru": "Оплата по QR/СБП с ненулевой комиссией при нулевом тарифе",
      "when": {
        "and": [
          {
            "op": "eq",
            "field": "operation.op_type",
            "value": "card_payment"
          },
          {
            "op": "eq",
            "field": "operation.method",
            "value": "qr_sbp"
          },
          {
            "op": "gt",
            "field": "ledger.fee_amount",
            "value": 0
          },
          {
            "op": "eq",
            "field": "tariff.fee_pct",
            "value": 0
          },
          {
            "op": "eq",
            "field": "tariff.fee_fixed",
            "value": 0
          }
        ]
      }
    }
  ]
}
