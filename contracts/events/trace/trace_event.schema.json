{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitverse.ru/florren/vibebashers/contracts/events/trace/trace_event.schema.json",
  "title": "TraceEvent — событие следа объекта (ТЗ 28.3)",
  "description": "Потолки ответа следа: before_depth ≤ 3, before ≤ 40 событий; after ≤ 200; веер по умолчанию 8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "phase",
    "ts_sim",
    "ts_real",
    "actor",
    "title_ru",
    "brief_ru",
    "key_facts",
    "badges",
    "links",
    "importance",
    "run_id"
  ],
  "properties": {
    "id": { "type": "string", "description": "Стабильный идентификатор события в ответе (EVT-…)" },
    "kind": { "$ref": "../common.schema.json#/$defs/trace_event_kind" },
    "phase": { "$ref": "../common.schema.json#/$defs/trace_phase" },
    "ts_sim": { "type": ["string", "null"], "format": "date-time" },
    "ts_real": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label_ru"],
      "properties": {
        "kind": { "$ref": "../common.schema.json#/$defs/trace_actor" },
        "label_ru": { "type": "string", "maxLength": 120 }
      }
    },
    "object_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "title_ru": { "type": "string", "maxLength": 200 },
    "brief_ru": { "type": "string", "maxLength": 500 },
    "key_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label_ru", "value_ru"],
        "properties": {
          "label_ru": { "type": "string", "maxLength": 80 },
          "value_ru": { "type": "string", "maxLength": 200 },
          "masked": { "type": "boolean", "default": false }
        }
      }
    },
    "badges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llm_source": { "$ref": "../common.schema.json#/$defs/llm_source" },
        "amount_rub": { "type": ["number", "null"] },
        "policy": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine_step": { "type": ["string", "null"], "description": "Ссылка на шаг в «Под капотом»" },
        "journey": { "type": ["string", "null"] },
        "trace": { "type": ["string", "null"] }
      }
    },
    "importance": { "type": "string", "enum": ["key", "detail"] },
    "run_id": { "type": "string", "description": "SR-… или live" },
    "order_warning": { "type": "boolean", "description": "true, если порядок событий расходится с временем" }
  },
  "examples": [
    {
      "id": "EVT-sig-created-1",
      "kind": "signal_created",
      "phase": "subject",
      "ts_sim": "2026-10-01T10:00:00Z",
      "ts_real": "2026-10-27T08:00:00Z",
      "actor": { "kind": "system", "label_ru": "Приёмный слой" },
      "object_ref": { "kind": "signal", "ref": "SIG-000123" },
      "title_ru": "Сигнал принят",
      "brief_ru": "Жалоба из чата поступила в обработку.",
      "key_facts": [{ "label_ru": "Канал", "value_ru": "Чат", "masked": false }],
      "badges": {},
      "links": { "engine_step": null, "journey": "/journey/SIG-000123", "trace": "/trace/signal/SIG-000123" },
      "importance": "key",
      "run_id": "SR-0012"
    }
  ]
}
