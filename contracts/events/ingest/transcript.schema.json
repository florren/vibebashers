{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitverse.ru/florren/vibebashers/contracts/events/ingest/transcript.schema.json",
  "title": "Готовый текстовый транскрипт диалога (ДТЗ FR-1.1, FR-4.1): JSON-формат приёма; TXT конвертируется в эту схему",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "turns"
  ],
  "properties": {
    "external_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "$ref": "../common.schema.json#/$defs/transcript_kind"
    },
    "branch_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "VSP-0042"
    },
    "employee_public_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "EMP-00007"
    },
    "desk_no": {
      "type": [
        "integer",
        "null"
      ]
    },
    "client": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "contact_hints": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "deal_product": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "geo": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/geo"
        },
        {
          "type": "null"
        }
      ]
    },
    "analyses": {
      "type": "array",
      "uniqueItems": true,
      "default": [
        "client_signal",
        "employee_quality"
      ],
      "items": {
        "type": "string",
        "enum": [
          "client_signal",
          "employee_quality"
        ]
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speaker",
          "text"
        ],
        "properties": {
          "seq": {
            "type": [
              "integer",
              "null"
            ]
          },
          "speaker": {
            "type": "string",
            "enum": [
              "employee",
              "client"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "t0_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "t1_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "external_id": "scenario10_retail",
      "kind": "branch_retail",
      "branch_code": "VSP-0042",
      "employee_public_id": "EMP-00011",
      "desk_no": 5,
      "client": {
        "client_id": 2301,
        "contact_hints": null
      },
      "deal_product": "Вклад «Накопительный»",
      "started_at": "2026-10-21T11:05:00+03:00",
      "geo": {
        "region_code": "RU-SAM",
        "city_id": 63,
        "lat": null,
        "lon": null,
        "source": "client_profile"
      },
      "analyses": [
        "client_signal",
        "employee_quality"
      ],
      "turns": [
        {
          "seq": 1,
          "speaker": "employee",
          "text": "Слушаю.",
          "t0_ms": 0,
          "t1_ms": 900
        },
        {
          "seq": 2,
          "speaker": "client",
          "text": "Хочу открыть вклад, какая ставка?",
          "t0_ms": 1000,
          "t1_ms": 3500
        },
        {
          "seq": 3,
          "speaker": "employee",
          "text": "По вкладу «Накопительный» ставка четырнадцать процентов.",
          "t0_ms": 3600,
          "t1_ms": 6900
        },
        {
          "seq": 4,
          "speaker": "client",
          "text": "А на сайте написано девять с половиной.",
          "t0_ms": 7000,
          "t1_ms": 9000
        },
        {
          "seq": 5,
          "speaker": "employee",
          "text": "Вы вообще читали условия, прежде чем сюда идти?",
          "t0_ms": 9100,
          "t1_ms": 11800
        }
      ],
      "meta": {
        "txt_source": true
      }
    }
  ]
}
