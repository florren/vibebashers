# CX Pulse Control — скопируйте в .env. Секреты только здесь; .env в .gitignore.
APP_ENV=dev                      # dev | test | prod
APP_SECRET=change-me             # install.sh генерирует автоматически
APP_LANG=ru
APP_PORT=8000
PROFILE=lite                     # lite (1 000 клиентов) | demo (5 000) | stress (20 000)
SIM_SEED=42

# PostgreSQL 16 (docker compose поднимает cx/cx@postgres:5432/cx_pulse)
DATABASE_URL=postgresql+psycopg://cx:cx@localhost:5432/cx_pulse
DATABASE_URL_TEST=postgresql+psycopg://cx:cx@localhost:5432/cx_pulse_test

# LLM: mock работает без сети; gigachat требует ключ авторизации (Authorization key из личного кабинета)
LLM_PROVIDER=mock                # gigachat | openai_compat | replay | mock
LLM_CHAIN=gigachat,replay,mock   # порядок failover
LLM_RECORD=false                 # true — записывать кассеты replay в data/cassettes
GIGACHAT_AUTH_KEY_1=
GIGACHAT_AUTH_KEY_2=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=false        # true + CA Минцифры в контейнере для prod
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LOCAL_LLM_BASE_URL=
CASSETTES_DIR=../data/cassettes

# интеграции
TELEGRAM_BOT_TOKEN=
MAILPIT_ENABLED=false
STT_PROVIDER=none                # vosk | browser | none
COMPLIANCE_ALERT_THRESHOLD=3     # срабатываний за встречу до алерта руководителю (ДТЗ FR-2.4)
